rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function roleDoc(universityId) {
      return /databases/$(database)/documents/universities/$(universityId)/roles/$(request.auth.uid);
    }

    function isUniversityAdmin(universityId) {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || (
            exists(roleDoc(universityId))
            && get(roleDoc(universityId)).data.role == 'admin'
          )
        );
    }


    function isUniversityViewer(universityId) {
      return isSignedIn()
        && exists(roleDoc(universityId))
        && (
          get(roleDoc(universityId)).data.role == 'viewer'
          || get(roleDoc(universityId)).data.role == 'editor'
          || get(roleDoc(universityId)).data.role == 'admin'
        );
    }

    function isUniversityEditor(universityId) {
      return isSignedIn()
        && exists(roleDoc(universityId))
        && (
          get(roleDoc(universityId)).data.role == 'editor'
          || get(roleDoc(universityId)).data.role == 'admin'
        );
    }
    function isOpenPilotCampus(universityId) {
      return universityId == 'sarpy-county'
        || universityId == 'sarpy'
        || universityId == 'sarpy-ne'
        || universityId == 'cherokee-mental-health'
        || universityId == 'cherokee'
        || universityId == 'cherokee-mh';
    }

    // Cherokee-only bypass for floorAdjustments writes, deliberately not the
    // shared isOpenPilotCampus() (which also matches Sarpy identifiers) —
    // this collection's write rule is being loosened for Cherokee only, to
    // match the posture every other Cherokee collection already has via
    // isOpenPilotCampus(); Sarpy's floorAdjustments permission is unchanged.
    function isCherokeeCampus(universityId) {
      return universityId == 'cherokee-mental-health'
        || universityId == 'cherokee'
        || universityId == 'cherokee-mh';
    }

    function canWriteFloorAdjustment(universityId) {
      return isUniversityAdmin(universityId)
        || isCherokeeCampus(universityId);
    }

    function canCreateEngagementMarker(universityId) {
      return isUniversityAdmin(universityId)
        || isOpenPilotCampus(universityId);
    }

    function canWriteTechnicalAssessment(universityId) {
      return isUniversityAdmin(universityId)
        || isOpenPilotCampus(universityId);
    }

    function canWriteMaintenanceIssue(universityId) {
      return isUniversityAdmin(universityId)
        || isOpenPilotCampus(universityId);
    }

    function canWritePlannerCopilot(universityId) {
      return isUniversityAdmin(universityId)
        || isOpenPilotCampus(universityId);
    }

    function canCreateDrawingEntry(universityId) {
      return isUniversityAdmin(universityId)
        || isOpenPilotCampus(universityId);
    }
    match /moves/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /universities/{universityId} {
      allow read: if true;
      allow write: if isUniversityAdmin(universityId);

      match /roles/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isUniversityAdmin(universityId));
        allow write: if isUniversityAdmin(universityId);
      }

      match /markers/{docId} {
        allow read: if true;
        allow create: if canCreateEngagementMarker(universityId);
        allow update, delete: if isUniversityAdmin(universityId);
      }

      match /buildingConditions/{docId} {
        allow read: if true;
        allow write: if isUniversityAdmin(universityId);
      }

      match /buildingAssessments/{docId} {
        allow read: if true;
        allow write: if canWriteTechnicalAssessment(universityId);
      }

      match /maintenanceIssues/{docId} {
        allow read: if true;
        allow create, update, delete: if canWriteMaintenanceIssue(universityId);
      }

      match /plannerCopilotPolicies/{docId} {
        allow read: if canWritePlannerCopilot(universityId);
        allow create, update, delete: if canWritePlannerCopilot(universityId);
      }

      match /plannerCopilotFeedback/{docId} {
        allow read: if canWritePlannerCopilot(universityId);
        allow create, update, delete: if canWritePlannerCopilot(universityId);
      }

      // Capital Priorities shell (Capital Compass integration, Option B).
      // Admin-only in both directions — this is an internal planning tool,
      // not exposed to public/client routes. Read-only relationship to
      // buildings/buildingAssessments/buildingConditions: this collection
      // is never written to by any existing code path.
      match /capitalPriorities/{buildingId} {
        allow read, write: if isUniversityAdmin(universityId);
      }

      // Classroom Utilization Planner. Admin-only in both directions, same
      // posture as capitalPriorities immediately above — internal planning
      // tool, not exposed to any public/client route. Hastings-only is
      // enforced by the app's enableClassroomUtilization flag gate, not
      // repeated here, consistent with how every other collection in this
      // file scopes by isUniversityAdmin(universityId) rather than a
      // hardcoded tenant id.
      match /spaceConfig/{spaceCategory} {
        allow read, write: if isUniversityAdmin(universityId);
      }
      match /terms/{termId} {
        allow read, write: if isUniversityAdmin(universityId);
      }
      match /roomUtilizationMeta/{roomKey} {
        allow read, write: if isUniversityAdmin(universityId);
      }
      match /courseMeetings/{meetingId} {
        allow read, write: if isUniversityAdmin(universityId);
      }

      match /floorAdjustments/{docId} {
        allow read: if true;
        allow write: if canWriteFloorAdjustment(universityId);
      }

      match /planningScenarios/{scenarioId} {
        allow read, write: if isUniversityAdmin(universityId);
      }

      match /renoScenarios/{scenarioId} {
        allow read, write: if isUniversityAdmin(universityId);
      }

      match /drawingEntries/{entryId} {
        allow read: if isUniversityAdmin(universityId);
        allow create: if canCreateDrawingEntry(universityId);
        allow update, delete: if isUniversityAdmin(universityId);
      }

      match /buildings/{buildingId} {
        allow read: if true;
        allow write: if isUniversityAdmin(universityId);

        match /floors/{floorId} {
          allow read: if true;
          allow write: if isUniversityAdmin(universityId);

          match /rooms/{roomId} {
            allow read: if true;
            allow write: if isUniversityEditor(universityId);

            match /history/{entryId} {
              allow read: if isUniversityAdmin(universityId);
              allow create: if isUniversityEditor(universityId);
              allow update, delete: if false;
            }
          }
        }
      }
    }
  }
}



